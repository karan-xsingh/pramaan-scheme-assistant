# LLM (any OpenAI-compatible chat endpoint). Defaults below are for Groq.
# Leave LLM_API_KEY empty to run in extractive mode (no LLM, answers are quoted passages).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Retriever: "tfidf" (default, no downloads) or "dense" (sentence-transformers + FAISS)
RETRIEVER=tfidf
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Retrieval tuning
TOP_K=4
MIN_SCORE=0.08

# CORS origins for the frontend (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Web fallback (optional). When the verified library has no answer, Grok (xAI) is asked to find
# official government pages, which this app then downloads and checks itself.
# Needs an xAI key (different from the Groq key above). Leave empty to turn the fallback off.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
WEB_SEARCH=1
# At most 5 are sent to xAI. Pages from any other domain are never downloaded.
WEB_ALLOWED_DOMAINS=myscheme.gov.in,india.gov.in,gov.in,nic.in
WEB_RATE_LIMIT_PER_MIN=6
